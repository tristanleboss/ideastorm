# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The test suite builds its own SQLite file per run (see tests/DatabaseTestCase.php) so a
# test run never touches the development database.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
IDEASTORM_UPLOAD_DIR="%kernel.project_dir%/var/uploads_test"
IDEASTORM_MAX_UPLOAD_SIZE=1048576
