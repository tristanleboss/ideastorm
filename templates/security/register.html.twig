{% extends 'base.html.twig' %}

{% block title %}Create an account · IdeaStorm{% endblock %}
{% block body_class %}page--narrow{% endblock %}

{% block body %}
    <div class="shell auth">
        <h1 class="auth__title">Create your account</h1>
        <p class="auth__lead">An account is what lets you vote, comment and add your own ideas.</p>

        {% for message in errors['_'] ?? [] %}
            <p class="flash flash--error" role="alert">{{ message }}</p>
        {% endfor %}

        <form method="post" action="{{ path('app_register') }}" class="auth__form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

            <div class="field{{ errors.displayName is defined ? ' field--invalid' }}">
                <label for="displayName">Display name</label>
                <input type="text" id="displayName" name="displayName" value="{{ submitted.displayName }}" required autofocus autocomplete="name">
                {% for message in errors.displayName ?? [] %}<p class="field__error">{{ message }}</p>{% endfor %}
            </div>

            <div class="field{{ errors.email is defined ? ' field--invalid' }}">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ submitted.email }}" required autocomplete="email">
                {% for message in errors.email ?? [] %}<p class="field__error">{{ message }}</p>{% endfor %}
            </div>

            <div class="field{{ errors.password is defined ? ' field--invalid' }}">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8">
                <p class="field__hint">At least 8 characters.</p>
                {% for message in errors.password ?? [] %}<p class="field__error">{{ message }}</p>{% endfor %}
            </div>

            <button type="submit" class="btn btn--primary btn--block">Create account</button>
        </form>

        {% if socialProviders is not empty %}
            <div class="auth__divider"><span>or sign up with</span></div>
            <div class="auth__social">
                {% for provider in socialProviders %}
                    <a class="btn btn--social btn--social-{{ provider.icon }}" href="{{ path('connect_start', {service: provider.key}) }}">
                        {{ include('security/_provider_icon.html.twig', {icon: provider.icon}) }}
                        <span>{{ provider.label }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

        <p class="auth__switch">Already have an account? <a href="{{ path('app_login') }}">Sign in</a>.</p>
    </div>
{% endblock %}
